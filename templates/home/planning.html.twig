{% extends 'base.html.twig' %}

{% block title %}Oxymaux - Mon planning{% endblock %}

{% block body %}

<section class=" mx-auto mt-10 px-4">
    <h1 class="text-4xl text-center mt-20 font-semibold">Mon planning</h1>
    <p class="text-center mt-4 text-gray-600">
        Découvrez mon planning mensuel pour ne rien manquer de mes activités et événements à venir.
    </p>
    {% if app.user and 'ROLE_ADMIN' in app.user.roles %}
    <div class="flex justify-end mb-6 max-w-7xl mx-auto">
        <a href="{{ path('app_add_activity') }}" class="px-4 py-2 bg-[#7a96a1] text-white text-shadow-md text-shadow-black rounded hover:bg-[#5a6b7a] transition">Ajouter une activité <i class="fa-solid fa-plus"></i></a>
    </div>
    {% endif %}

    {# Prochaine activité #}
    <div
        data-controller="upcoming-activity"
        data-upcoming-activity-activities-value='
            {
                {% for serviceId, activity in upcomingActivities %}
                    "{{ serviceId }}": "{% if activity %}{{ activity.date|format_datetime(pattern='d MMMM yyyy', locale='fr') }} {% else %}{{ activity }}{% endif %}"
                    {% if not loop.last %},{% endif %}
                {% endfor %}
            }
        '
        class="flex flex-col md:flex-row items-center justify-center gap-2 my-5 max-w-7xl mx-auto"
    >
        <p class="text-center text-blue-700">
            Prochaine date pour l'activité suivante :
        </p>

        <select
            data-upcoming-activity-target="service"
            data-action="change->upcoming-activity#updateUpcomingActivity"
            class="px-2 py-1 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
            {% for service in allServices %}
                <option value="{{ service.id }}">
                    {{ service.name }}
                </option>
            {% endfor %}
        </select>

        <p
            data-upcoming-activity-target="date"
            class="text-center text-lg"
        ></p>
    </div>

     {# Calendrier #}

    <div data-controller="planning-export" data-planning-export-month-value="{{ currentMonth|format_datetime(pattern='MMMM-yyyy', locale="fr") }}" class="max-w-7xl mx-auto">

        <div
            data-planning-export-target="planning"
            class="bg-sky-300 rounded-3xl p-2 md:p-4 overflow-x-auto"
        >
            <div class="flex justify-end w-full">
                <img alt="Logo Oxymaux" src="{{ asset('images/logo.jpeg') }}" class="w-16 h-16 rounded-full">
            </div>

            {# Légende des logos #}
            {% if services|length > 0 %}
            <div class="flex flex-col md:flex-row items-center gap-6 mb-6">
                <h3 class="text-lg font-semibold text-gray-700">Activités proposées ce mois-ci :</h3>
                <div class="flex-1 flex flex-wrap gap-4">
                {% for service in services %}
                    <div class="flex items-center gap-2">
                        <img src="{{ asset('images/' ~ service.logo) }}" alt="{{ service.name }}" class="w-8 h-8 object-cover rounded-full">
                        <span class="text-sm font-medium text-gray-700">{{ service.name }}</span>
                    </div>
                {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if currentMonth|date("Y-m") != "now"|date("Y-m") %}
            <div data-planning-export-target="notExported" class="flex justify-start mb-4">
                <a href="{{ path('app_planning') }}" class="text-blue-700 hover:text-pink-300 transition duration-300">
                    <i class="fa-solid fa-arrow-left"></i> Revenir au mois actuel
                </a>
            </div>
            {% endif %}
            {# Titre du mois #}
            <div data-planning-export-target="header" class="flex justify-between items-center mb-6">

                <a data-planning-export-target="notExported" href="{{ path('app_planning', {'month': previousMonth|date('Y-m')}) }}" class="px-2 py-1 bg-white rounded-lg hover:bg-pink-300 transition duration-300">
                    ← {{ previousMonth|format_datetime(pattern='MMMM', locale="fr")|capitalize }}
                </a>

                <h2 class="text-xl md:text-3xl font-bold text-blue-700">
                    {{ currentMonth|format_datetime(pattern='MMMM yyyy', locale="fr")|capitalize }}
                </h2>

                <a data-planning-export-target="notExported" href="{{ path('app_planning', {'month': nextMonth|date('Y-m')}) }}" class="px-2 py-1 bg-white rounded-lg hover:bg-pink-300 transition duration-300">
                    {{ nextMonth|format_datetime(pattern='MMMM', locale="fr")|capitalize }} →
                </a>

            </div>

            {# Jours semaine #}
            <div class="grid grid-cols-7 gap-1 mb-4">

                {% set weekdays = ['L', 'M', 'M', 'J', 'V', 'S', 'D'] %}

                {% for day in weekdays %}
                    <div class="text-center text-xl font-bold text-blue-700">
                        {{ day }}
                    </div>
                {% endfor %}

            </div>

            {# Grille calendrier #}
            <div class="grid grid-cols-7 gap-1">

                {# Cases vides avant début du mois #}
                {% if startingDay > 1 %}
                    {% for i in 1..(startingDay - 1) %}
                        <div class="bg-transparent"></div>
                    {% endfor %}
                {% endif %}

                {# Jours du mois #}
                {% for day in 1.. daysInMonth %}
                    {% set isBlocked = false %}
                    {% set blockedType = '' %}
                    {% for dayOff in dayOffs %}
                        {% if dayOff.date|date("j") == day %}
                            {% set isBlocked = true %}
                            {% set blockedType = dayOff.type %}
                        {% endif %}
                    {% endfor %}

                    <div class="
                        {% if (day < "now"|date("j") and currentMonth|date("Y-m") == "now"|date("Y-m")) or (currentMonth|date("Y-m") < "now"|date("Y-m")) %}
                        bg-gray-300
                        {% elseif isBlocked %}
                        bg-zinc-300
                        {% else %}
                        bg-white
                        {% endif %}
                        rounded-2xl
                        {% if day == "now"|date("j") and currentMonth|date("Y-m") == "now"|date("Y-m") %}
                            border-yellow-300
                            border-4
                        {% else %}
                            border-pink-300
                            md:border-2
                        {% endif %}
                        min-h-20
                        md:min-h-40
                        p-1
                        shadow-sm
                        hover:shadow-lg
                        transition
                        relative
                    ">

                        {# Numéro du jour #}
                        <div class="text-lg md:text-xl font-bold text-sky-500">
                            {{ day }}
                        </div>

                        {% if app.user and 'ROLE_ADMIN' in app.user.roles and ((currentMonth|date("Y-m") == "now"|date("Y-m") and day >= "now"|date("j")) or currentMonth|date("Y-m") > "now"|date("Y-m")) %}
                            <div data-controller="confirm" data-planning-export-target="notExported" class="absolute top-1 right-1 flex-col md:flex items-center gap-1 z-10">
                                {% if not isBlocked %}
                                    <a href="{{ path('app_add_activity', {'date': currentMonth|date('Y-m') ~ '-' ~ day}) }}" class="flex text-gray-400 hover:text-blue-500 transition duration-300 cursor-pointer">
                                        <i class="fa-solid fa-plus"></i>
                                    </a>
                                {% endif %}
                                <button data-action="click->confirm#openModal" class="text-gray-400 hover:text-red-500 transition duration-300 cursor-pointer">
                                    {% if isBlocked %}
                                        <i class="fa-solid fa-lock"></i>
                                    {% else %}
                                        <i class="fa-solid fa-unlock"></i>
                                    {% endif %}
                                </button>
                                
                                <div data-confirm-target="modal" class="hidden fixed inset-0 flex items-center justify-center z-50">
                                    <form action="{{ path('app_block_date', {'day': day, 'month': currentMonth|date('m'), 'year': currentMonth|date('Y')}) }}" method="post" class="bg-white p-6 rounded-lg shadow-lg w-80">
                                        <input type="hidden" name="_token" value="{{ csrf_token('block_date_' ~ currentMonth|date('Y') ~ '-' ~ currentMonth|date('m') ~ '-' ~ day) }}">

                                        {% if not isBlocked %}
                                            <h3 class="text-lg font-semibold mb-2">Bloquer la date</h3>
                                        {% else %}
                                            <h3 class="text-lg font-semibold mb-2">Débloquer la date ou modifier la raison</h3>
                                            <p class="text-sm text-gray-600 mb-4">
                                                La date du {{ day }}/{{ currentMonth|date("m") }}/{{ currentMonth|date("Y") }} est actuellement bloquée pour la raison suivante : 
                                            </p>
                                            <p class="text-lg text-gray-800 font-semibold mb-4 text-center">
                                                {{ blockedType|capitalize }}
                                            </p>
                                        {% endif %}

                                        {# Case à cocher pour débloquer #}
                                        {% if isBlocked %}
                                            <div class="mb-4 flex items-center gap-2">
                                                <input 
                                                    type="checkbox" 
                                                    id="unlock-{{ day }}" 
                                                    name="type" 
                                                    value="unlock" 
                                                    data-action="change->confirm#toggleUnlock"
                                                    class="cursor-pointer"
                                                >
                                                <label for="unlock-{{ day }}" class="text-sm text-gray-600 cursor-pointer font-medium select-none">
                                                    Voulez-vous débloquer cette date ?
                                                </label>
                                            </div>
                                        {% endif %}

                                        {# Bloc contenant le select (affiché par défaut) #}
                                        <div data-confirm-target="reasonWrapper" class="mb-4">
                                            <label for="block-reason-{{ day }}" class="block text-sm text-gray-600 mb-2">
                                                Choisissez la raison pour bloquer la date du {{ day }}/{{ currentMonth|date("m") }}/{{ currentMonth|date("Y") }} :
                                            </label>
                                            
                                            <select 
                                                id="block-reason-{{ day }}" 
                                                name="type" 
                                                data-confirm-target="reasonSelect"
                                                class="w-full mb-4 p-2 border rounded focus:outline-none focus:ring-2 focus:ring-red-500"
                                            >
                                                <option value="{{ typeRepos }}" {% if blockedType == typeRepos %}selected{% endif %}>Repos</option>
                                                <option value="{{ typeConges }}" {% if blockedType == typeConges %}selected{% endif %}>Congés</option>
                                                <option value="{{ typeFormation }}" {% if blockedType == typeFormation %}selected{% endif %}>Formation</option>
                                                <option value="{{ typeFerie }}" {% if blockedType == typeFerie %}selected{% endif %}>Férié</option>
                                            </select>
                                        </div>

                                        <div class="flex justify-end gap-2">
                                            <button type="button" data-action="click->confirm#cancel" class="px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400 transition cursor-pointer">Annuler</button>
                                            <button type="submit" class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600 transition cursor-pointer">Valider</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        {% endif %}

                        {# Affichage du type bloqué #}
                        {% if isBlocked %}
                            <div class="grid grid-cols-1 grid-rows-1 items-center justify-center h-25 w-full pointer-events-none">
                                <div class="rotate-90 md:rotate-0 -translate-x-1/4 md:translate-x-0 w-fit mx-auto text-xs md:text-sm font-bold px-3 py-1 {{ blockedType == typeRepos ? 'text-sky-500' : (blockedType == typeConges ? 'text-pink-500' : (blockedType == typeFormation ? 'text-orange-500' : 'text-red-500')) }}">
                                    {{ blockedType|upper }}
                                </div>
                            </div>
                        {% endif %}

                        {# Activités du jour #}
                        {% for activity in activities %}
                            {% if activity.date|date("j") == day %}
                                {# Version Desktop (MD et +) #}
                                <a href="{{ path('app_activity', {'id': activity.id}) }}" class="hidden md:flex flex-col items-center gap-2 mt-3 text-sm border border-sky-300 p-2 rounded-lg h-fit w-full">
                                    <p class="flex justify-between items-center gap-2 w-full">
                                        {% if activity.start and activity.end %}
                                            {{ activity.start|date("H:i") }} - {{ activity.end|date("H:i") }}
                                        {% elseif activity.start %}
                                            {{ activity.start|date("H:i") }}
                                        {% else %}
                                            <span>Horaires à définir</span>
                                        {% endif %}
                                        <img src="{{ asset('images/' ~ activity.service.logo) }}" alt="{{ activity.service.name }}" class="w-8 h-8 object-cover rounded-full">
                                    </p>
                                    
                                    {# Nom de l'activité + unique badge alignés proprement dans le flux #}
                                    <div class="flex flex-col items-center justify-center w-full gap-2 mt-2">
                                        {# Le nom de l'activité seul #}
                                        <p class="text-center font-medium leading-tight w-full">
                                            {{ activity.service.name }}
                                        </p>
                                        
                                        {# Conteneur du badge converti en table pour forcer le centrage vertical absolu #}
                                        {% if activity.canceled or activity.id in fullActivities %}
                                            <div class="flex w-full justify-center">
                                                <span class="export-badge text-xs px-2 py-0.5 rounded-full {{ activity.canceled ? 'text-white bg-red-500' : 'text-black bg-yellow-500' }}">
                                                    {{ activity.canceled ? 'Annulée' : 'Complet' }}
                                                </span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </a>

                                {# Version Mobile #}
                                <a href="{{ path('app_activity', {'id': activity.id}) }}" class="md:hidden flex justify-center mt-1 relative">
                                    <img src="{{ asset('images/' ~ activity.service.logo) }}" alt="{{ activity.service.name }}" class="w-8 h-8 object-cover rounded-full">
                                    {% if activity.canceled %}
                                        <div class="absolute top-0 right-0 z-20 bg-red-500 w-2 h-2 rounded-full"></div>
                                    {% elseif activity.id in fullActivities %}
                                        <div class="absolute top-0 right-0 z-20 bg-yellow-500 w-2 h-2 rounded-full"></div>
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                {% endfor %}

            </div>

        </div>
        <div class="md:hidden flex items-center gap-2 mt-4 ml-2">
            <div class="w-2 h-2 bg-yellow-500 rounded-full"></div>
            <p class="text-xs text-gray-700">Activité complète</p>
        </div>
        <div class="md:hidden flex items-center gap-2 ml-2">
            <div class="w-2 h-2 bg-red-500 rounded-full"></div>
            <p class="text-xs text-gray-700">Activité annulée</p>
        </div>
        {% if app.user and 'ROLE_ADMIN' in app.user.roles %}
            <div class="hidden md:flex justify-center mt-4">
                <button
                    data-action="click->planning-export#download"
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer transition duration-300"
                >
                    <i class="fa-solid fa-download"></i> Télécharger le planning
                </button>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}