{% extends 'base.html.twig' %}

{% block title %}Renvoyer l’e-mail de confirmation{% endblock %}

{% block body %}
<section class="max-w-2xl w-full mx-auto mt-10 px-4">
    <h1 class="text-4xl text-center mt-20 mb-10 font-semibold">Confirmer votre adresse e-mail</h1>
    <form method="post" class="bg-sky-100 p-4 rounded-xl space-y-4 mt-10 flex flex-col items-center w-full">
        <p class="text-center">Saisissez votre adresse e-mail pour recevoir un nouveau lien de confirmation.</p>
        <input type="hidden" name="_token" value="{{ csrf_token('resend_verification') }}">
        <div class="flex items-center gap-4 w-full">
            <label for="email" class="w-1/3">Email</label>
            <input type="email" name="email" id="email" class="bg-white border border-sky-500 rounded w-2/3" autocomplete="email" required>
        </div>
        <button class="bg-sky-300 py-2 px-4 rounded-full hover:bg-sky-400 cursor-pointer" type="submit">
            Renvoyer l’e-mail
        </button>
    </form>
</section>
{% endblock %}
